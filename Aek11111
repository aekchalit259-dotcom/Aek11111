-- ฟังก์ชั่นตรวจสอบบทบาท
local function GetRole(player)
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    
    if (backpack and backpack:FindFirstChild("Knife")) or (character and character:FindFirstChild("Knife")) then
        return "Murder"
    elseif (backpack and backpack:FindFirstChild("Gun")) or (character and character:FindFirstChild("Gun")) then
        return "Sheriff"
    else
        return "Innocent"
    end
end

-- 1. Kill All (เฉพาะ Murderer)
Tab:CreateButton({
   Name = "ฆ่าทุกคน - القتل الجماعي (Murderer Only)",
   Callback = function()
       local char = LocalPlayer.Character
       local knife = (LocalPlayer.Backpack:FindFirstChild("Knife") or (char and char:FindFirstChild("Knife")))
       
       if not knife then
           Rayfield:Notify({
               Title = "خطأ (ข้อผิดพลาด)",
               Content = "คุณไม่ได้เป็น Murderer หรือไม่มีมีด",
               Duration = 3
           })
           return
       end

       if char and char:FindFirstChild("Humanoid") then
           if knife.Parent == LocalPlayer.Backpack then
               knife.Parent = char
           end
           
           for _, target in pairs(Players:GetPlayers()) do
               if target ~= LocalPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChild("Humanoid").Health > 0 then
                   target.Character.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -2)
                   task.wait(0.05)
                   if knife:FindFirstChild("Stab") then
                       knife.Stab:FireServer()
                   end
               end
           end
       end
   end,
})

